><meta name=\"bingbot\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\"/><link rel=\"sitemap\" href=\"https://nameverse.site/sitemap.xml\" type=\"application/xml\" title=\"NameVerse Sitemap\"/><meta http-equiv=\"x-dns-prefetch-control\" content=\"on\"/><meta name=\"next-size-adjust\" content=\"\"/><meta name=\"theme-color\" content=\"#1E3A5F\"/><title>About NameVerse — Editorial Team, Mission &amp; Verification... | NameVerse</title><meta name=\"description\" content=\"NameVerse is a trusted baby name knowledge base reviewed by linguists, scholars, and researchers. Meet our editorial team, explore our verification process, and discover why parents rely on our 65K+ name records.\"/><link rel=\"author\" href=\"https://nameverse.site/about\"/><meta name=\"author\" content=\"NameVerse Editorial Team\"/><link rel=\"manifest\" href=\"/manifest.json\"/><meta name=\"keywords\" content=\"baby names, baby names 2026, islamic baby names, hindu baby names, christian baby names, quranic names, biblical names, sanskrit names, muslim baby names, baby name meanings, lucky numbers, baby name generator, name suggestions, trending baby names 2026, baby names with meanings, unique baby names, popular baby names, arabic names, urdu names\"/><meta name=\"creator\" content=\"NameVerse\"/><meta name=\"publisher\" content=\"NameVerse\"/><meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\"/><meta name=\"category\" content=\"Baby Names, Culture, Religion\"/><meta name=\"classification\" content=\"Baby Name Dictionary &amp; Cultural Knowledge Base\"/><link rel=\"canonical\" href=\"https://nameverse.site/about\"/><meta property=\"og:title\" content=\"About NameVerse — Editorial Team, Mission &amp; Verification...\"/><meta property=\"og:description\" content=\"NameVerse is a trusted baby name knowledge base reviewed by linguists, scholars, and researchers. Meet our editorial team and verification process.\"/><meta property=\"og:url\" content=\"https://nameverse.site/about\"/><meta property=\"og:site_name\" content=\"NameVerse\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:site\" content=\"@NameVerseOfficial\"/><meta name=\"twitter:creator\" content=\"@NameVerseOfficial\"/><meta name=\"twitter:title\" content=\"Baby Names, Meanings, Origins &amp; Lucky Numbers | NameVerse\"/><meta name=\"twitter:description\" content=\"Discover baby names with verified meanings, origins, lucky numbers, pronunciation guides, and cultural context across Islamic, Hindu, Christian and global traditions.\"/><meta name=\"twitter:image\" content=\"https://nameverse.site/og-home.png\"/><link rel=\"shortcut icon\" href=\"/logo.svg\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.0x3dzn~oxb6tn.ico\" sizes=\"256x256\" type=\"image/x-icon\"/><link rel=\"icon\" href=\"/logo.svg\" type=\"image/svg+xml\"/><link rel=\"apple-touch-icon\" href=\"/logo.svg\" type=\"image/svg+xml\" sizes=\"180x180\"/><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"@id\":\"https://nameverse.site/#organization\",\"name\":\"NameVerse\",\"alternateName\":\"NameVerse — Cultural Name Knowledge Base\",\"url\":\"https://nameverse.site\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://nameverse.site/logo.svg\",\"width\":192,\"height\":192},\"description\":\"NameVerse is a Cultural Name Knowledge Base and Multilingual Onomastics System for structured cultural and linguistic analysis of personal names across civilizations.\",\"sameAs\":[\"https://twitter.com/NameVerseOfficial\"],\"knowsAbout\":{\"@type\":\"Thing\",\"name\":\"Cultural Onomastics\",\"description\":\"Structured cultural and linguistic analysis of personal names across civilizations.\"}}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"@id\":\"https://nameverse.site/#website\",\"name\":\"NameVerse\",\"alternateName\":\"NameVerse — Cultural Name Knowledge Base\",\"url\":\"https://nameverse.site\",\"description\":\"A structured cultural and linguistic knowledge graph for human names. Multilingual onomastics system for cross-cultural name research and analysis.\",\"publisher\":{\"@type\":\"Organization\",\"@id\":\"https://nameverse.site/#organization\"},\"inLanguage\":\"en-US\",\"about\":{\"@type\":\"Thing\",\"name\":\"Cultural Onomastics — Linguistic Name Analysis\",\"description\":\"Structured cultural and linguistic analysis of personal names across civilizations.\"},\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":{\"@type\":\"EntryPoint\",\"urlTemplate\":\"https://nameverse.site/search?q={search_term_string}\"},\"query-input\":\"required name=search_term_string\"}}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://nameverse.site\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Baby Names\",\"item\":\"/names\"}]}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"CollectionPage\",\"name\":\"Popular Baby Names by Religion\",\"description\":\"Browse top baby names from different faiths — Muslim, Hindu, and Christian — with meanings and translations.\",\"url\":\"/names\",\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"NameVerse — Cultural Name Knowledge Base\",\"url\":\"https://nameverse.site\"},\"mainEntity\":{\"@type\":\"ItemList\",\"itemListElement\":[]}}</script><script src=\"/_next/static/chunks/03~yq9q893hmn.js\" noModule=\"\"></script></head><body class=\"inter_70e21a4e-module__hyQdtq__variable fraunces_c34708e9-module__0Tq2Na__variable antialiased nv-body nv-page\"><div hidden=\"\"><!--$--><!--/$--></div><div id=\"temp-wrapper\"><!--$--><nav class=\"sticky top-0 z-[100] border-b border-nv-border bg-nv-surface/90 backdrop-blur\"><div class=\"mx-auto flex h-14 max-w-7xl items-center justify-between px-4 sm:px-6\"><div class=\"h-8 w-28 rounded-full bg-nv-surface-subtle\"></div><div class=\"hidden h-9 w-40 rounded-full bg-nv-surface-subtle lg:block\"></div></div></nav><!--/$--><div id=\"container-desktop-4x1\" class=\"hidden lg:block\"></div><div class=\"nv-route-chrome\"><div aria-hidden=\"true\" class=\"nv-route-ornament\"></div><div class=\"nv-route-content\"><main class=\"min-h-screen bg-[color:var(--nv-canvas)] nv-body\"><div class=\"nv-container nv-stack\"><section class=\"relative overflow-hidden rounded-[2rem] border border-[color:var(--nv-border)] bg-white/62 backdrop-blur shadow-[0_22px_60px_-44px_var(--nv-shadow)]\"><div class=\"pointer-events-none absolute inset-0 opacity-60 [background:radial-gradient(circle_at_10%_20%,rgba(14,165,164,0.20),transparent_42%),radial-gradient(circle_at_80%_30%,rgba(79,70,229,0.18),transparent_44%),radial-gradient(circle_at_30%_90%,rgba(245,158,11,0.20),transparent_46%)]\"></div><div class=\"relative p-6 sm:p-8 lg:p-12\"><div class=\"inline-flex items-center gap-2 rounded-full bg-slate-900 px-3 py-1 text-xs font-semibold uppercase tracking-[0.16em] text-white\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-book-open h-4 w-4\" aria-hidden=\"true\"><path d=\"M12 7v14\"></path><path d=\"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z\"></path></svg> About NameVerse</div><h1 class=\"nv-display mt-5 text-3xl font-bold leading-[0.98] tracking-tight text-[color:var(--nv-ink)] sm:text-4xl md:text-5xl lg:text-6xl\">Trusted name research for parents worldwide.</h1><p class=\"mt-4 max-w-2xl text-base leading-relaxed text-[color:var(--nv-muted)] sm:text-lg\">NameVerse is a cultural name knowledge base combining 65,000+ name records with verified meanings, origins, and cultural context across Islamic, Hindu, Christian, and global traditions.</p><div class=\"mt-6 grid gap-3 sm:grid-cols-3\"><div class=\"rounded-2xl border border-[color:var(--nv-border)] bg-white/60 p-4\"><div class=\"text-2xl font-bold text-[color:var(--nv-ink)]\">65K+</div><div class=\"text-xs font-semibold text-[color:var(--nv-muted)]\">Name records</div></div><div class=\"rounded-2xl border border-[color:var(--nv-border)] bg-white/60 p-4\"><div class=\"text-2xl font-bold text-[color:var(--nv-ink)]\">4</div><div class=\"text-xs font-semibold text-[color:var(--nv-muted)]\">Traditions covered</div></div><div class=\"rounded-2xl border border-[color:var(--nv-border)] bg-white/60 p-4\"><div class=\"text-2xl font-bold text-[color:var(--nv-ink)]\">25<!-- -->+</div><div class=\"text-xs font-semibold text-[color:var(--nv-muted)]\">Authoritative sources</div></div></div></div></section><section class=\"rounded-[2rem] border border-[color:var(--nv-border)] bg-white/62 backdrop-blur shadow-[0_22px_60px_-44px_var(--nv-shadow)]\"><div class=\"mb-6 flex items-start gap-3\"><div class=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-amber-100 text-amber-700 shadow-sm\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield h-5 w-5\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path></svg></div><div><p class=\"text-xs font-bold uppercase tracking-[0.18em] text-[color:var(--nv-muted)]\">Our Mission</p><h2 class=\"nv-display text-xl font-semibold text-[color:var(--nv-ink)]\">Building the most trustworthy name resource on the internet.</h2><p class=\"mt-1 text-sm text-[color:var(--nv-muted)]\">Every name carries a story — a linguistic history, a cultural tradition, and a meaning that connects generations.</p></div></div><div class=\"grid gap-4 sm:grid-cols-2 lg:grid-cols-4\"><div class=\"rounded-2xl border border-[color:var(--nv-border)] bg-white/60 p-5 transition hover:-translate-y-0.5 hover:shadow-md\"><div class=\"flex items-center gap-2 mb-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check h-5 w-5 text-[color:var(--nv-accent-2)]\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><h3 class=\"text-sm font-bold text-[color:var(--nv-ink)]\">Accuracy</h3></div><p class=\"text-sm text-[color:var(--nv-muted)] leading-relaxed\">Every meaning verified against authoritative linguistic sources.</p></div><div class=\"rounded-2xl border border-[color:var(--nv-border)] bg-white/60 p-5 transition hover:-translate-y-0.5 hover:shadow-md\"><div class=\"flex items-center gap-2 mb-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check h-5 w-5 text-[color:var(--nv-accent-2)]\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><h3 class=\"text-sm font-bold text-[color:var(--nv-ink)]\">Cultural Respect</h3></div><p class=\"text-sm text-[color:var(--nv-muted)] leading-relaxed\">Names presented within authentic cultural and religious contexts.</p></div><div class=\"rounded-2xl border border-[color:var(--nv-border)] bg-white/60 p-5 transition hover:-translate-y-0.5 hover:shadow-md\"><div class=\"flex items-center gap-2 mb-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check h-5 w-5 text-[color:var(--nv-accent-2)]\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><h3 class=\"text-sm font-bold text-[color:var(--nv-ink)]\">Transparency</h3></div><p class=\"text-sm text-[color:var(--nv-muted)] leading-relaxed\">Editorial process, sources, and methodology publicly documented.</p></div><div class=\"rounded-2xl border border-[color:var(--nv-border)] bg-white/60 p-5 transition hover:-translate-y-0.5 hover:shadow-md\"><div class=\"flex items-center gap-2 mb-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check h-5 w-5 text-[color:var(--nv-accent-2)]\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><h3 class=\"text-sm font-bold text-[color:var(--nv-ink)]\">Inclusivity</h3></div><p class=\"text-sm text-[color:var(--nv-muted)] leading-relaxed\">Equal depth across Islamic, Hindu, Christian, and global traditions.</p></div></div></section><section class=\"rounded-[2rem] border border-[color:var(--nv-border)] bg-white/62 backdrop-blur shadow-[0_22px_60px_-44px_var(--nv-shadow)]\"><div class=\"mb-6 flex items-start gap-3\"><div class=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-amber-100 text-amber-700 shadow-sm\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users h-5 w-5\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><path d=\"M16 3.128a4 4 0 0 1 0 7.744\"></path><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle></svg></div><div><p class=\"text-xs font-bold uppercase tracking-[0.18em] text-[color:var(--nv-muted)]\">Editorial Team</p><h2 class=\"nv-display text-xl font-semibold text-[color:var(--nv-ink)]\">Linguists, scholars, and researchers.</h2><p class=\"mt-1 text-sm text-[color:var(--nv-muted)]\">Our team specializes in Arabic, Sanskrit, Hebrew, Greek, and Latin name traditions.</p></div></div><div class=\"grid gap-4 sm:grid-cols-2\"><div class=\"rounded-[2rem] border border-[color:var(--nv-border)] bg-white/62 p-6 backdrop-blur shadow-[0_22px_60px_-44px_var(--nv-shadow)] transition hover:-translate-y-1 hover:shadow-md\"><div class=\"flex items-start gap-4 mb-4\"><div class=\"grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-[color:var(--nv-ink)] text-white text-lg font-bold\">DAH</div><div><h3 class=\"text-base font-bold text-[color:var(--nv-ink)]\">Dr. Amina Hassan</h3><p class=\"text-sm font-semibold text-[color:var(--nv-accent-2)]\">Chief Editor — Islamic Names Research</p></div></div><p class=\"text-sm leading-relaxed text-[color:var(--nv-muted)] mb-4\">Dr. Amina Hassan is a linguist specializing in Arabic and Islamic naming traditions. She holds a PhD in Arabic Linguistics from the University of Oxford and has published 15+ peer-reviewed papers on Semitic name etymology.</p><div class=\"space-y-2 text-sm\"><div class=\"flex items-center gap-2 text-[color:var(--nv-muted)]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-award h-4 w-4 text-[color:var(--nv-accent-2)]\" aria-hidden=\"true\"><path d=\"m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526\"></path><circle cx=\"12\" cy=\"8\" r=\"6\"></circle></svg><span>PhD Arabic Linguistics, University of Oxford</span></div><div class=\"flex items-center gap-2 text-[color:var(--nv-muted)]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe h-4 w-4 text-[color:var(--nv-accent-2)]\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg><span>Arabic, English, Urdu, Persian</span></div><div class=\"flex items-center gap-2 text-[color:var(--nv-muted)]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-book-open h-4 w-4 text-[color:var(--nv-accent-2)]\" aria-hidden=\"true\"><path d=\"M12 7v14\"></path><path d=\"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z\"></path></svg><span>Arabic Linguistics, Quranic Names, Semitic Etymology, Islamic Onomastics</span></div></div><a href=\"https://linkedin.com/in/dr-amina-hassan\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-flex items-center gap-2 mt-4 text-sm font-semibold text-[color:var(--nv-accent-2)] transition hover:text-[color:var(--nv-accent)]\">View LinkedIn Profile <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-3.5 w-3.5\" aria-hidden=\"true\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></div><div class=\"rounded-[2rem] border border-[color:var(--nv-border)] bg-white/62 p-6 backdrop-blur shadow-[0_22px_60px_-44px_var(--nv-shadow)] transition hover:-translate-y-1 hover:shadow-md\"><div class=\"flex items-start gap-4 mb-4\"><div class=\"grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-[color:var(--nv-ink)] text-white text-lg font-bold\">PRS</div><div><h3 class=\"text-base font-bold text-[color:var(--nv-ink)]\">Prof. Rajesh Sharma</h3><p class=\"text-sm font-semibold text-[color:var(--nv-accent-2)]\">Senior Editor — Hindu &amp; Sanskrit Names</p></div></div><p class=\"text-sm leading-relaxed text-[color:var(--nv-muted)] mb-4\">Professor Rajesh Sharma is a Sanskrit scholar and historian at the University of Delhi. He specializes in Vedic literature, Hindu naming ceremonies, and the linguistic evolution of Sanskrit names.</p><div class=\"space-y-2 text-sm\"><div class=\"flex items-center gap-2 text-[color:var(--nv-muted)]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-award h-4 w-4 text-[color:var(--nv-accent-2)]\" aria-hidden=\"true\"><path d=\"m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526\"></path><circle cx=\"12\" cy=\"8\" r=\"6\"></circle></svg><span>PhD Sanskrit, University of Delhi; Professor of Linguistics</span></div><div class=\"flex items-center gap-2 text-[color:var(--nv-muted)]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe h-4 w-4 text-[color:var(--nv-accent-2)]\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg><span>Sanskrit, Hindi, English, Tamil</span></div><div class=\"flex items-center gap-2 text-[color:var(--nv-muted)]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-book-open h-4 w-4 text-[color:var(--nv-accent-2)]\" aria-hidden=\"true\"><path d=\"M12 7v14\"></path><path d=\"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z\"></path></svg><span>Sanskrit Linguistics, Vedic Studies, Hindu Naming Traditions, Indian Etymology</span></div></div><a href=\"https://linkedin.com/in/prof-rajesh-sharma\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-flex items-center gap-2 mt-4 text-sm font-semibold text-[color:var(--nv-accent-2)] transition hover:text-[color:var(--nv-accent)]\">View LinkedIn Profile <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-3.5 w-3.5\" aria-hidden=\"true\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></div><div class=\"rounded-[2rem] border border-[color:var(--nv-border)] bg-white/62 p-6 backdrop-blur shadow-[0_22px_60px_-44px_var(--nv-shadow)] transition hover:-translate-y-1 hover:shadow-md\"><div class=\"flex items-start gap-4 mb-4\"><div class=\"grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-[color:var(--nv-ink)] text-white text-lg font-bold\">SM</div><div><h3 class=\"text-base font-bold text-[color:var(--nv-ink)]\">Sarah Mitchell</h3><p class=\"text-sm font-semibold text-[color:var(--nv-accent-2)]\">Editor — Christian &amp; Biblical Names</p></div></div><p class=\"text-sm leading-relaxed text-[color:var(--nv-muted)] mb-4\">Sarah Mitchell is a biblical scholar and historian with expertise in Hebrew, Greek, and Latin name origins. She has contributed to multiple biblical reference works and theological dictionaries.</p><div class=\"space-y-2 text-sm\"><div class=\"flex items-center gap-2 text-[color:var(--nv-muted)]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-award h-4 w-4 text-[color:var(--nv-accent-2)]\" aria-hidden=\"true\"><path d=\"m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526\"></path><circle cx=\"12\" cy=\"8\" r=\"6\"></circle></svg><span>MA Biblical Studies, University of Cambridge</span></div><div class=\"flex items-center gap-2 text-[color:var(--nv-muted)]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe h-4 w-4 text-[color:var(--nv-accent-2)]\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg><span>English, Hebrew, Greek, Latin</span></div><div class=\"flex items-center gap-2 text-[color:var(--nv-muted)]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-book-open h-4 w-4 text-[color:var(--nv-accent-2)]\" aria-hidden=\"true\"><path d=\"M12 7v14\"></path><path d=\"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z\"></path></svg><span>Biblical Names, Hebrew Etymology, Christian Onomastics, Theological Research</span></div></div><a href=\"https://linkedin.com/in/sarah-mitchell\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-flex items-center gap-2 mt-4 text-sm font-semibold text-[color:var(--nv-accent-2)] transition hover:text-[color:var(--nv-accent)]\">View LinkedIn Profile <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-3.5 w-3.5\" aria-hidden=\"true\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></div><div class=\"rounded-[2rem] border border-[color:var(--nv-border)] bg-white/62 p-6 backdrop-blur shadow-[0_22px_60px_-44px_var(--nv-shadow)] transition hover:-translate-y-1 hover:shadow-md\"><div class=\"flex items-start gap-4 mb-4\"><div class=\"grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-[color:var(--nv-ink)] text-white text-lg font-bold\">DYK</div><div><h3 class=\"text-base font-bold text-[color:var(--nv-ink)]\">Dr. Yusuf Khan</h3><p class=\"text-sm font-semibold text-[color:var(--nv-accent-2)]\">Research Director — Cultural Name Analysis</p></div></div><p class=\"text-sm leading-relaxed text-[color:var(--nv-muted)] mb-4\">Dr. Yusuf Khan leads cross-cultural name research at NameVerse. His work bridges Arabic, Persian, Turkish, and South Asian naming traditions with modern linguistic analysis.</p><div class=\"space-y-2 text-sm\"><div class=\"flex items-center gap-2 text-[color:var(--nv-muted)]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-award h-4 w-4 text-[color:var(--nv-accent-2)]\" aria-hidden=\"true\"><path d=\"m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526\"></path><circle cx=\"12\" cy=\"8\" r=\"6\"></circle></svg><span>PhD Comparative Linguistics, Harvard University</span></div><div class=\"flex items-center gap-2 text-[color:var(--nv-muted)]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe h-4 w-4 text-[color:var(--nv-accent-2)]\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg><span>Arabic, Persian, Turkish, Urdu, English</span></div><div class=\"flex items-center gap-2 text-[color:var(--nv-muted)]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-book-open h-4 w-4 text-[color:var(--nv-accent-2)]\" aria-hidden=\"true\"><path d=\"M12 7v14\"></path><path d=\"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z\"></path></svg><span>Cross-Cultural Onomastics, Persian Etymology, Turkish Linguistics, South Asian Names</span></div></div><a href=\"https://linkedin.com/in/dr-yusuf-khan\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-flex items-center gap-2 mt-4 text-sm font-semibold text-[color:var(--nv-accent-2)] transition hover:text-[color:var(--nv-accent)]\">View LinkedIn Profile <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-3.5 w-3.5\" aria-hidden=\"true\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></div></div></section><section class=\"rounded-[2rem] border border-[color:var(--nv-border)] bg-white/62 backdrop-blur shadow-[0_22px_60px_-44px_var(--nv-shadow)]\"><div class=\"mb-6 flex items-start gap-3\"><div class=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-amber-100 text-amber-700 shadow-sm\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-award h-5 w-5\" aria-hidden=\"true\"><path d=\"m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526\"></path><circle cx=\"12\" cy=\"8\" r=\"6\"></circle></svg></div><div><p class=\"text-xs font-bold uppercase tracking-[0.18em] text-[color:var(--nv-muted)]\">Fact-Checking &amp; Review</p><h2 class=\"nv-display text-xl font-semibold text-[color:var(--nv-ink)]\">Independent verification by subject-matter experts.</h2><p class=\"mt-1 text-sm text-[color:var(--nv-muted)]\">Every name entry is cross-referenced by specialists in the relevant linguistic tradition.</p></div></div><div class=\"grid gap-3 sm:grid-cols-3\"><div class=\"rounded-2xl border border-[color:var(--nv-border)] bg-white/60 p-5 text-center transition hover:-translate-y-0.5 hover:shadow-md\"><div class=\"mx-auto grid h-12 w-12 place-items-center rounded-2xl bg-amber-100 text-amber-700 font-bold\">FA</div><h3 class=\"mt-3 text-sm font-bold text-[color:var(--nv-ink)]\">Fatima Ali</h3><p class=\"text-xs font-semibold text-[color:var(--nv-accent-2)]\">Senior Fact Checker — Islamic Names</p><p class=\"mt-2 text-xs text-[color:var(--nv-muted)]\">MA Islamic Studies, Al-Azhar University</p></div><div class=\"rounded-2xl border border-[color:var(--nv-border)] bg-white/60 p-5 text-center transition hover:-translate-y-0.5 hover:shadow-md\"><div class=\"mx-auto grid h-12 w-12 place-items-center rounded-2xl bg-amber-100 text-amber-700 font-bold\">MC</div><h3 class=\"mt-3 text-sm font-bold text-[color:var(--nv-ink)]\">Michael Chen</h3><p class=\"text-xs font-semibold text-[color:var(--nv-accent-2)]\">Research Analyst — Biblical Names</p><p class=\"mt-2 text-xs text-[color:var(--nv-muted)]\">MTh Theology, Fuller Seminary</p></div><div class=\"rounded-2xl border border-[color:var(--nv-border)] bg-white/60 p-5 text-center transition hover:-translate-y-0.5 hover:shadow-md\"><div class=\"mx-auto grid h-12 w-12 place-items-center rounded-2xl bg-amber-100 text-amber-700 font-bold\">PP</div><h3 class=\"mt-3 text-sm font-bold text-[color:var(--nv-ink)]\">Priya Patel</h3><p class=\"text-xs font-semibold text-[color:var(--nv-accent-2)]\">Fact Checker — Hindu &amp; Sanskrit Names</p><p class=\"mt-2 text-xs text-[color:var(--nv-muted)]\">MA Sanskrit, Banaras Hindu University</p></div></div></section><section class=\"rounded-[2rem] border border-[color:var(--nv-border)] bg-white/62 backdrop-blur shadow-[0_22px_60px_-44px_var(--nv-shadow)]\"><div class=\"mb-6 flex items-start gap-3\"><div class=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-amber-100 text-amber-700 shadow-sm\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-book-open h-5 w-5\" aria-hidden=\"true\"><path d=\"M12 7v14\"></path><path d=\"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z\"></path></svg></div><div><p class=\"text-xs font-bold uppercase tracking-[0.18em] text-[color:var(--nv-muted)]\">Editorial Process</p><h2 class=\"nv-display text-xl font-semibold text-[color:var(--nv-ink)]\">How we verify every name.</h2><p class=\"mt-1 text-sm text-[color:var(--nv-muted)]\">A five-step process ensures accuracy, cultural respect, and transparent sourcing.</p></div></div><div class=\"grid gap-6 md:grid-cols-2 lg:grid-cols-5\"><div class=\"flex gap-4\"><div class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[color:var(--nv-ink)] text-white text-sm font-bold\">1</div><div><h3 class=\"text-sm font-bold text-[color:var(--nv-ink)]\">Research</h3><p class=\"mt-1 text-sm text-[color:var(--nv-muted)] leading-relaxed\">Each name is researched using authoritative linguistic sources including classical dictionaries, religious texts, and academic references.</p></div></div><div class=\"flex gap-4\"><div class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[color:var(--nv-ink)] text-white text-sm font-bold\">2</div><div><h3 class=\"text-sm font-bold text-[color:var(--nv-ink)]\">Verification</h3><p class=\"mt-1 text-sm text-[color:var(--nv-muted)] leading-relaxed\">Meanings, origins, and cultural context are cross-referenced against multiple sources to ensure accuracy.</p></div></div><div class=\"flex gap-4\"><div class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[color:var(--nv-ink)] text-white text-sm font-bold\">3</div><div><h3 class=\"text-sm font-bold text-[color:var(--nv-ink)]\">Review</h3><p class=\"mt-1 text-sm text-[color:var(--nv-muted)] leading-relaxed\">Content is reviewed by subject-matter experts specializing in the relevant linguistic and cultural tradition.</p></div></div><div class=\"flex gap-4\"><div class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[color:var(--nv-ink)] text-white text-sm font-bold\">4</div><div><h3 class=\"text-sm font-bold text-[color:var(--nv-ink)]\">Publication</h3><p class=\"mt-1 text-sm text-[color:var(--nv-muted)] leading-relaxed\">Approved content is published with clear attribution, publication dates, and source citations.</p></div></div><div class=\"flex gap-4\"><div class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[color:var(--nv-ink)] text-white text-sm font-bold\">5</div><div><h3 class=\"text-sm font-bold text-[color:var(--nv-ink)]\">Ongoing Review</h3><p class=\"mt-1 text-sm text-[color:var(--nv-muted)] leading-relaxed\">All content is periodically reviewed and updated to maintain accuracy and relevance.</p></div></div></div></section><section class=\"rounded-[2rem] border border-[color:var(--nv-border)] bg-white/62 backdrop-blur shadow-[0_22px_60px_-44px_var(--nv-shadow)]\"><div class=\"mb-6 flex items-start gap-3\"><div class=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-amber-100 text-amber-700 shadow-sm\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe h-5 w-5\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg></div><div><p class=\"text-xs font-bold uppercase tracking-[0.18em] text-[color:var(--nv-muted)]\">Sources</p><h2 class=\"nv-display text-xl font-semibold text-[color:var(--nv-ink)]\">Authoritative references we rely on.</h2><p class=\"mt-1 text-sm text-[color:var(--nv-muted)]\">NameVerse draws from dictionaries, lexicons, encyclopedias, and academic databases.</p></div></div><ul class=\"grid gap-2 sm:grid-cols-2 lg:grid-cols-3\"><li class=\"flex items-start gap-2 text-sm text-[color:var(--nv-muted)]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check h-4 w-4 text-[color:var(--nv-accent-2)] mt-0.5 shrink-0\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span><strong class=\"text-[color:var(--nv-ink)]\">Oxford English Dictionary</strong> <!-- -->(<!-- -->Dictionary<!-- -->)<a href=\"https://www.oed.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-[color:var(--nv-accent-2)] hover:underline ml-1\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-3 w-3 inline\" aria-hidden=\"true\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></span></li><li class=\"flex items-start gap-2 text-sm text-[color:var(--nv-muted)]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check h-4 w-4 text-[color:var(--nv-accent-2)] mt-0.5 shrink-0\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span><strong class=\"text-[color:var(--nv-ink)]\">Cambridge Dictionary</strong> <!-- -->(<!-- -->Dictionary<!-- -->)<a href=\"https://dictionary.cambridge.org\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-[color:var(--nv-accent-2)] hover:underline ml-1\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-3 w-3 inline\" aria-hidden=\"true\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></span></li><li class=\"flex items-start gap-2 text-sm text-[color:var(--nv-muted)]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=